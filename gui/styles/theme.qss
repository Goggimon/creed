* {
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Inter", sans-serif;
    color: #F3F4F6;
}

QWidget#central_widget {
    background-color: #0E0F12;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
}

QFrame#title_bar {
    background-color: #131418;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
}

QFrame#sidebar,
QFrame#right_panel {
    background-color: #131418;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
}

QFrame#workspace_frame {
    background-color: #101114;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
}

QFrame#systems_panel,
QFrame#activity_panel,
QFrame#panel_card {
    background-color: #181A20;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 10px;
}

QFrame#user_msg {
    background-color: #1E2430;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 12px;
}

QFrame#ai_msg {
    background-color: #16181D;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
}

QLabel#msg_role_user {
    color: #93C5FD;
    font-size: 11px;
    font-weight: 600;
}

QLabel#msg_role_ai {
    color: #9CA3AF;
    font-size: 11px;
    font-weight: 600;
}

QLabel#msg_body {
    color: #F3F4F6;
    font-size: 13px;
}

QLabel#tool_badge {
    color: #60A5FA;
    font-family: "SF Mono", Menlo, monospace;
    font-size: 11px;
    padding: 4px 8px;
}

QLabel#tab_title {
    color: #F9FAFB;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.2px;
}

QLabel#section_header {
    color: #9CA3AF;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3px;
}

QLabel#meta_label {
    color: #71717A;
    font-size: 11.5px;
}

QLabel#accent_label {
    color: #93C5FD;
    font-family: "SF Mono", Menlo, monospace;
    font-size: 11px;
}

QLabel#status_value {
    color: #F3F4F6;
    font-family: "SF Mono", Menlo, monospace;
    font-size: 12px;
    font-weight: 600;
}

QScrollArea#chat_area {
    background-color: transparent;
    border: none;
}

QScrollArea#chat_area > QWidget > QWidget {
    background-color: transparent;
}

QLineEdit,
QPlainTextEdit {
    background-color: #141519;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 8px;
    padding: 8px 11px;
    color: #F3F4F6;
    font-size: 12.5px;
}

QLineEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid rgba(255, 255, 255, 0.28);
    background-color: #171920;
}

QFrame#connection_overlay {
    background-color: rgba(14, 15, 18, 215);
    border-radius: 12px;
}

QFrame#connection_overlay_card {
    background-color: #181A20;
    border: 1px solid rgba(251, 146, 60, 0.55);
    border-radius: 12px;
}

QLabel#connection_overlay_title {
    color: #FB923C;
    font-size: 13px;
    font-weight: 600;
}

QPushButton#primary_btn {
    background-color: #F4F4F5;
    color: #09090B;
    font-weight: 600;
    font-size: 11.5px;
    border-radius: 8px;
    padding: 7px 14px;
    border: none;
}

QPushButton#primary_btn:hover {
    background-color: #FFFFFF;
}

QPushButton#primary_btn:pressed {
    background-color: #D4D4D8;
}

QPushButton#secondary_btn {
    background-color: #1C1E24;
    color: #D4D4D8;
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 11.5px;
    font-weight: 500;
    border-radius: 8px;
    padding: 6px 11px;
}

QPushButton#secondary_btn:hover {
    background-color: #242730;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #FFFFFF;
}

QPushButton#nav_btn {
    background-color: transparent;
    color: #9CA3AF;
    text-align: left;
    border: none;
    border-left: 2px solid transparent;
    border-radius: 7px;
    padding: 7px 12px;
    font-size: 12.5px;
    font-weight: 500;
}

QPushButton#nav_btn:hover {
    background-color: rgba(255, 255, 255, 0.04);
    color: #F3F4F6;
}

QPushButton#nav_btn[active="true"] {
    background-color: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    border-left: 2px solid #F4F4F5;
    font-weight: 600;
}

QPushButton#win_btn {
    background-color: #1C1E24;
    color: #9CA3AF;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 6px;
    font-size: 10px;
}

QPushButton#win_btn:hover {
    background-color: #262932;
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #FFFFFF;
}

QProgressBar {
    background-color: #141519;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    height: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #60A5FA;
    border-radius: 4px;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.12);
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.28);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
