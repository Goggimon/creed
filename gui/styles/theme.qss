/* CREED V2.0 — SPATIAL OS DESIGN SYSTEM */

* {
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Inter", sans-serif;
    color: #EDEFF5;
}

QWidget#central_widget {
    background-color: #07080C;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 16px;
}

QFrame#top_telemetry_bar {
    background-color: #0B0D14;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
}

QFrame#bottom_spatial_dock {
    background-color: #0B0D14;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}

QFrame#workspace_frame {
    background-color: #07080C;
    border: none;
}

/* Architectural Translucent Surfaces */
QFrame#panel_card,
QFrame#systems_panel,
QFrame#activity_panel {
    background-color: rgba(16, 19, 28, 220);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
}

/* Editorial Borderless Message Blocks (NO generic chat bubbles) */
QFrame#user_msg {
    background-color: rgba(255, 255, 255, 0.03);
    border: none;
    border-right: 2px solid #67E8F9;
    border-radius: 2px;
}

QFrame#ai_msg {
    background-color: transparent;
    border: none;
    border-left: 2px solid #A78BFA;
    border-radius: 2px;
}

QLabel#msg_role_user {
    color: #67E8F9;
    font-family: "Menlo", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#msg_role_ai {
    color: #A78BFA;
    font-family: "Menlo", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#msg_body {
    color: #EDEFF5;
    font-size: 13.5px;
}

QLabel#tool_badge {
    color: #FBBF24;
    font-family: "Menlo", monospace;
    font-size: 11px;
    padding: 4px 8px;
}

QLabel#tab_title {
    color: #F8FAFC;
    font-family: "SF Pro Display", -apple-system, sans-serif;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.3px;
}

QLabel#section_header {
    color: #94A3B8;
    font-family: "Menlo", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.1px;
}

QLabel#meta_label {
    color: #7D8798;
    font-family: "Menlo", monospace;
    font-size: 10.5px;
}

QLabel#accent_label {
    color: #67E8F9;
    font-family: "Menlo", monospace;
    font-size: 11px;
    font-weight: 600;
}

QLabel#status_value {
    color: #F8FAFC;
    font-family: "Menlo", monospace;
    font-size: 11.5px;
    font-weight: 700;
}

QScrollArea#chat_area {
    background-color: transparent;
    border: none;
}

QScrollArea#chat_area > QWidget > QWidget {
    background-color: transparent;
}

QLineEdit,
QPlainTextEdit {
    background-color: #0E1017;
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: 6px;
    padding: 8px 12px;
    color: #F8FAFC;
    font-size: 13px;
}

QLineEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #67E8F9;
    background-color: #12151F;
}

QFrame#connection_overlay {
    background-color: rgba(7, 8, 12, 224);
}

QFrame#connection_overlay_card {
    background-color: #11141E;
    border: 1px solid #F59E0B;
    border-radius: 6px;
}

QLabel#connection_overlay_title {
    color: #F59E0B;
    font-family: "Menlo", monospace;
    font-size: 13px;
    font-weight: 700;
}

QPushButton#primary_btn {
    background-color: #EDEFF5;
    color: #07080C;
    font-family: "Menlo", monospace;
    font-weight: 700;
    font-size: 11px;
    border-radius: 5px;
    padding: 7px 14px;
    border: none;
}

QPushButton#primary_btn:hover {
    background-color: #FFFFFF;
}

QPushButton#secondary_btn {
    background-color: #131620;
    color: #CBD5E1;
    border: 1px solid rgba(255, 255, 255, 0.11);
    font-family: "Menlo", monospace;
    font-size: 11px;
    font-weight: 600;
    border-radius: 5px;
    padding: 6px 11px;
}

QPushButton#secondary_btn:hover {
    background-color: #1A1E2C;
    border: 1px solid rgba(103, 232, 249, 0.55);
    color: #F8FAFC;
}

/* Spatial Bottom Dock Navigation Buttons */
QPushButton#dock_btn {
    background-color: transparent;
    color: #7D8798;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 4px;
    padding: 6px 11px;
    font-family: "Menlo", monospace;
    font-size: 10.5px;
    font-weight: 600;
}

QPushButton#dock_btn:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: #EDEFF5;
}

QPushButton#dock_btn[active="true"] {
    background-color: rgba(103, 232, 249, 0.10);
    color: #67E8F9;
    border-bottom: 2px solid #67E8F9;
    font-weight: 700;
}

QPushButton#cmd_btn {
    background-color: #11141D;
    color: #94A3B8;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 5px;
    padding: 4px 11px;
    font-family: "Menlo", monospace;
    font-size: 10.5px;
}

QPushButton#cmd_btn:hover {
    border: 1px solid #67E8F9;
    color: #F8FAFC;
}

QPushButton#win_btn {
    background-color: #141722;
    color: #94A3B8;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 5px;
    font-size: 10px;
}

QPushButton#win_btn:hover {
    background-color: #202536;
    border: 1px solid #67E8F9;
    color: #F8FAFC;
}

QProgressBar {
    background-color: #0E1017;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 3px;
    height: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #67E8F9, stop:0.5 #A78BFA, stop:1 #F472B6);
    border-radius: 3px;
}

QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 5px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.14);
    min-height: 24px;
    border-radius: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #67E8F9;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
