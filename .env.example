OLLAMA_MODEL=qwen2.5:7b
OLLAMA_ENDPOINT=http://localhost:11434/api/chat
OLLAMA_TIMEOUT=60.0

# Optional: Picovoice Porcupine key (leave empty to use offline Whisper wake word 'creed')
PORCUPINE_ACCESS_KEY=
CREED_WAKE_WORD=creed

# Optional: macOS TTS voice and speed (WPM)
CREED_MACOS_VOICE=Samantha
CREED_TTS_RATE=190

# Optional: Android ADB over Wi-Fi (e.g. 192.168.1.50:5555)
CREED_PHONE_ADB_TARGET=
